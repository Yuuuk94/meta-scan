# Build context must be the monorepo ROOT (not this package dir) so pnpm can see the
# workspace lockfile. See the `build:docker` script in this package's package.json.
#
#   docker build -f packages/meta-scan-api/dockerfile -t meta-scan-api .   # from repo root

# ---- build stage ----
FROM node:20-slim AS build
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates git && \
  rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

# Workspace manifests first for better layer caching
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/meta-scan-api/package.json ./packages/meta-scan-api/package.json
COPY packages/meta-scan-front/package.json ./packages/meta-scan-front/package.json

RUN pnpm install --frozen-lockfile

COPY packages/meta-scan-api ./packages/meta-scan-api

RUN pnpm --filter meta-scan-api build

# Produce a self-contained, production-only copy of just this package
# (resolves pnpm's symlinked node_modules into real files, safe to copy standalone)
RUN pnpm --filter meta-scan-api deploy --prod --legacy /deploy/meta-scan-api

# ---- runtime stage ----
FROM node:20-slim
WORKDIR /app

# Chromium & 폰트 설치 (Lighthouse/Chrome 의존성)
RUN apt-get update && apt-get install -y --no-install-recommends \
  chromium \
  fonts-liberation \
  tzdata \
  ca-certificates && \
  rm -rf /var/lib/apt/lists/*

COPY --from=build /deploy/meta-scan-api ./

# Cloud Run 기본 포트
ENV PORT=8080
ENV NODE_ENV=production
ENV PUBLIC_URL=https://meta-scan-api-752797429874.us-central1.run.app
ENV FRONT_URL=https://meta-scan.vercel.app
ENV FRONT_TEST_URL=https://meta-scan.vercel.app
# chrome-launcher가 사용할 경로 지정 (배포 이미지 내 Chromium 경로)
ENV CHROME_PATH=/usr/bin/chromium

# 헬스체크/로그에 타임존 필요 시
# ENV TZ=Asia/Seoul

# Cloud Run은 비루트 유저로 실행됨. 추가 권한 설정 불필요.
CMD ["node", "dist/app.js"]
