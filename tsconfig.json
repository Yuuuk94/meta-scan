{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "src",
    "paths": {
      "@core/*": ["core/*"],
      "@config/*": ["config/*"],
      "@infra/*": ["infra/*"],
      "@modules/*": ["modules/*"]
    }
  },
  "include": ["src"]
}
